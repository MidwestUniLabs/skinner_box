# Skinner Box Client Configuration
# This runs on Raspberry Pi devices and connects to the self-hosted server

# ============================================
# SERVER API URL - REQUIRED
# ============================================

# RECOMMENDED: Tailscale VPN (most secure)
# Use server's Tailscale IP (get with: tailscale ip -4)
API_URL=http://100.x.x.x:8080

# Alternative: Tailscale MagicDNS (if enabled)
# API_URL=http://skinnerbox-server:8080

# Alternative: Local network (development only)
# API_URL=http://192.168.1.100:8080

# Alternative: Public domain (least secure, not recommended)
# API_URL=https://api.yourdomain.com

# ============================================
# DEVICE SETTINGS
# ============================================

# Unique device identifier (REQUIRED)
# Format: {institution}-{lab}-pi-{number}
# Example: uw-madison-lab-a-pi-01
DEVICE_ID=

# Application Settings
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=5000

# Encryption (for local token storage)
# Leave blank to auto-generate
FERNET_KEY=

# GPIO Settings (Raspberry Pi specific)
# Set to true if running on actual hardware with GPIO
USE_GPIO=true

# Logging
LOG_LEVEL=INFO
